# macOS
.DS_Store

# Xcode build artifacts
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# Reference clones / vendored upstream sources kept locally for grep,
# never pushed (see python-ios-lib + CodeBench upstream repos).
/_vendor/

# Busytex web build (~237 MB; texlive-basic.data is 100 MB which hits
# GitHub's per-file limit). Fetch separately from the busytex release
# and drop the unpacked bundle at ManimStudio/ManimStudio/Resources/Busytex/
# before building. busytex_pipeline.js and busytex.html are tracked:
# ManimStudio adds a plain-TeX driver to the pipeline, and busytex.html is
# its own host page (on-demand loading, the Swift bridge), so keep these
# copies when dropping in a new bundle.
ManimStudio/ManimStudio/Resources/Busytex/*
!ManimStudio/ManimStudio/Resources/Busytex/busytex_pipeline.js
!ManimStudio/ManimStudio/Resources/Busytex/busytex.html

# Last-archive logs from the SwiftSupport injector script.
scripts/last-archive-postaction.log

# App Store submission artifacts (resized PNGs + render scratch dir).
/_appstore_uploads/
/_preview_renders/scenes/media/
