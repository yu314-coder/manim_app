# The python-ios-lib SwiftPM resource bundles Xcode embeds in ManimStudio.app.
# Inputs of the "Install Python stdlib" build phase: listing them makes Xcode
# copy every bundle into the app BEFORE the script flattens them into
# app_packages/site-packages. Without it the copies race the script.
# install-python-stdlib.sh fails the build if SwiftPM builds a bundle that
# isn't listed here; add a line for it.
$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/python-ios-lib_BeautifulSoup.bundle
$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/python-ios-lib_CairoGraphics.bundle
